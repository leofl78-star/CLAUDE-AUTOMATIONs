# ============================================================
# Senta Aqui com o Léo — Social Media Auto-Poster
# Copie este arquivo para ".env" e preencha suas credenciais
# NUNCA commite o arquivo .env no GitHub
# ============================================================

# ------ CLAUDE (obrigatório para análise de vídeo) ----------
ANTHROPIC_API_KEY=sk-ant-...

# ------ TIKTOK ----------------------------------------------
# Obter em: https://developers.tiktok.com/
# Requer: app aprovado + conta business/creator
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ------ INSTAGRAM (Meta Graph API) -------------------------
# Obter em: https://developers.facebook.com/
# Requer: conta Business ou Creator + app aprovado
# Permissões necessárias: instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# URL pública temporária do vídeo (ex: via upload para Cloudinary, S3, etc.)
# Deixar em branco para usar upload direto (veja README)
INSTAGRAM_VIDEO_CDN_URL=

# ------ YOUTUBE (Google OAuth 2.0) -------------------------
# Obter em: https://console.cloud.google.com/
# 1. Crie um projeto > Ative YouTube Data API v3
# 2. Crie credenciais OAuth 2.0 (Desktop App)
# Na primeira execução, um browser vai abrir para você autorizar
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ------ X / TWITTER ----------------------------------------
# Obter em: https://developer.twitter.com/
# Requer: projeto aprovado + permissões de leitura e escrita
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
